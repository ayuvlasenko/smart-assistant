{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "type": "module",
  "description": "",
  "files": [
    "dist",
    "migrations",
    "migrate-mongo-config.js",
    "static"
  ],
  "scripts": {
    "start": "pnpm run build && fastify start -o -l info dist/app.js",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -w -p tsconfig.build.json",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch\" \"pnpm:dev:start\"",
    "dev:start": "pnpm run build && fastify start -o --ignore-watch=.ts$ -w -d -l info -P dist/app.js",
    "lint": "eslint \"src/**/*.{js,ts}\" \"migrations/**/*.js\" \"migrate-mongo-config.js\"",
    "format": "eslint --fix \"src/**/*.{js,ts}\" \"migrations/**/*.js\" \"migrate-mongo-config.js\" && prettier --write \"src/**/*.{js,ts}\" \"migrations/**/*.js\" \"migrate-mongo-config.js\"",
    "migrate:create": "migrate-mongo create -f ./migrate-mongo-config.js",
    "migrate:up": "migrate-mongo up -f ./migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f ./migrate-mongo-config.js",
    "migrate:status": "migrate-mongo status -f ./migrate-mongo-config.js",
    "test": "node --env-file=.env.test --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.js\""
  },
  "author": "ayuvlasenko",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@fastify/autoload": "6.3.1",
    "@fastify/cors": "11.3.0",
    "@fastify/env": "7.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/mongodb": "10.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/request-context": "7.0.0",
    "@fastify/sensible": "6.0.6",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "9.2.0",
    "@grammyjs/types": "5.0.0",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "ioredis": "6.0.0",
    "migrate-mongo": "14.0.7",
    "mongodb": "7.7.0",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "10.0.5",
    "fastify-cli": "8.0.2",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
