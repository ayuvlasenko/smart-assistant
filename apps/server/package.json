{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "description": "",
  "scripts": {
    "start": "npm run build && fastify start -o -l info dist/app.js",
    "build": "npx rimraf dist && tsc",
    "watch": "tsc -w",
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch\" \"npm:dev:start\"",
    "dev:start": "npm run build && fastify start -o --ignore-watch=.ts$ -w -d -l info -P dist/app.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "eslint --fix \"src/**/*.ts\" && prettier --write \"src/**/*.ts\"",
    "test": "echo \"No tests yet\""
  },
  "author": "ayuvlasenko",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.980.0",
    "@aws-sdk/lib-storage": "3.980.0",
    "@fastify/autoload": "6.3.0",
    "@fastify/cors": "11.0.1",
    "@fastify/env": "5.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/mongodb": "9.0.2",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.3",
    "@fastify/session": "11.1.0",
    "@fastify/static": "8.2.0",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "5.2.2",
    "@fastify/under-pressure": "9.0.3",
    "@grammyjs/types": "3.25.0",
    "@sinclair/typebox": "0.34.33",
    "ajv": "8.17.1",
    "bcrypt": "6.0.0",
    "close-with-grace": "2.2.0",
    "fastify": "5.3.3",
    "fastify-plugin": "5.0.1",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.16.0",
    "pino-pretty": "13.0.0"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "5.1.0",
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.23",
    "concurrently": "9.1.2",
    "fastify-cli": "7.4.0",
    "rimraf": "6.0.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
