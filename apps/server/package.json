{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "description": "",
  "scripts": {
    "start": "npm run build && fastify start -o -l info dist/app.js",
    "build": "npx rimraf dist && tsc",
    "watch": "tsc -w",
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch\" \"npm:dev:start\"",
    "dev:start": "npm run build && fastify start -o --ignore-watch=.ts$ -w -d -l info -P dist/app.js",
    "lint": "eslint \"src/**/*.{js,ts}\" \"migrations/**/*.js\" \"migrate-mongo-config.js\"",
    "format": "eslint --fix \"src/**/*.{js,ts}\" \"migrations/**/*.js\" \"migrate-mongo-config.js\" && prettier --write \"src/**/*.{js,ts}\" \"migrations/**/*.js\" \"migrate-mongo-config.js\"",
    "migrate:create": "migrate-mongo create -f ./migrate-mongo-config.js",
    "migrate:up": "migrate-mongo up -f ./migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f ./migrate-mongo-config.js",
    "migrate:status": "migrate-mongo status -f ./migrate-mongo-config.js",
    "test": "node --env-file=.env.test --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.js\""
  },
  "author": "ayuvlasenko",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.980.0",
    "@aws-sdk/lib-storage": "3.980.0",
    "@fastify/autoload": "6.3.1",
    "@fastify/cors": "11.2.0",
    "@fastify/env": "6.0.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/mongodb": "10.0.0",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/session": "11.1.1",
    "@fastify/static": "8.2.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.5",
    "@fastify/under-pressure": "9.0.3",
    "@grammyjs/types": "3.26.0",
    "@sinclair/typebox": "0.34.49",
    "ajv": "8.18.0",
    "bcrypt": "6.0.0",
    "close-with-grace": "2.5.0",
    "fastify": "5.8.4",
    "fastify-plugin": "5.1.0",
    "jsonwebtoken": "9.0.3",
    "migrate-mongo": "14.0.7",
    "mongodb": "7.1.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "6.1.0",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.23",
    "concurrently": "9.2.1",
    "fastify-cli": "8.0.0",
    "rimraf": "6.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  }
}
