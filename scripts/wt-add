#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: wt-add <branch-name> [base]

Creates a git worktree at .worktrees/<branch-name>, copies local configs
from the repo root and installs dependencies via mise.

Arguments:
  branch-name  Name of the new branch (also the directory name in .worktrees/)
  base         Base branch (default: origin/main)

Steps:
  1. git fetch origin
  2. git worktree add -b <branch-name> .worktrees/<branch-name> <base>
  3. Copies .env from the repo root
  4. mise trust && mise install && mise exec -- npm install
EOF
}

if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

branch="$1"
base="${2:-origin/main}"

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "Error: not inside a git repository" >&2
  exit 1
}

cd "$repo_root"

worktree_path=".worktrees/$branch"
new_dir="$repo_root/$worktree_path"

if [[ -e "$worktree_path" ]]; then
  echo "Error: $worktree_path already exists" >&2
  exit 1
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
  echo "Error: branch '$branch' already exists locally" >&2
  echo "Hint: use the existing branch directly — git worktree add $worktree_path $branch" >&2
  exit 1
fi

echo "==> git fetch origin"
git fetch origin

echo "==> git worktree add --no-track -b $branch $worktree_path $base"
git worktree add --no-track -b "$branch" "$worktree_path" "$base"

for file in .env; do
  if [[ -f "$repo_root/$file" ]]; then
    echo "==> copying $file"
    cp "$repo_root/$file" "$new_dir/$file"
  else
    echo "==> skipping $file (not in repo root)"
  fi
done

cd "$new_dir"

echo "==> mise trust"
mise trust

echo "==> mise install"
mise install

echo "==> mise exec -- npm install"
mise exec -- npm install

echo
echo "Done. Worktree: $new_dir"
